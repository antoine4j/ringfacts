# Copy this file to .env and fill in your own values for local runs.
# .env is gitignored — it never gets committed.
#
# The chats this bot knows about: the group it posts to, and the DM that gets
# failure self-reports. The webhook whitelist is derived from these two, so
# there is no third copy to keep in sync (lib/chat-ids.js).
#
# One JSON line, no trailing spaces. Both ids must be bare integers as
# strings — group ids are negative, and they outgrow what a JSON number holds
# safely. A malformed value is refused at startup rather than failing one
# Telegram message at a time.
#
# In the cloud this same value comes from the telegram-chat-ids secret; here
# it is a plain env var only because local runs have no Secret Manager mount.
TELEGRAM_CHAT_IDS={"group":"-1001234567890","admin":"123456789"}

# True secrets (bot token, Anthropic key, DB password) are NOT put here.
# Per AGENTS.md, those are pulled live from GCP Secret Manager on each run:
#   DATABASE_URL=$(gcloud secrets versions access latest --secret=neon-db-url) node hunter.js
