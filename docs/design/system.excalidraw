    },
    {
      "id": "claude-rev-7-b",
      "type": "text",
      "x": 3012,
      "y": 2680,
      "width": 382.79999999999995,
      "height": 165.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
