      "text": "8 · DON'T GROW THE CLAIM TEXT — an answer to your caveat",
      "originalText": "8 · DON'T GROW THE CLAIM TEXT — an answer to your caveat",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
