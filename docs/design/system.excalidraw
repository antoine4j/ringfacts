    {
      "id": "claude-rev-5-b",
      "type": "text",
      "x": 2012,
      "y": 2680,
      "width": 382.79999999999995,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 142357489,
      "version": 1,
      "versionNonce": 1572914363,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790191090513,
      "link": null,
      "locked": false,
      "text": "Not drawn. Today: headline + link, foreign headlines\ntranslated to English at post time.\nIf the message becomes the extractor's sentence, the\nextractor is user-facing: its language, tone and\nerrors reach the group, and translation moves into it.\nIf it stays headline + link, the claim text is internal\nonly and Qwen's re-wording noise (136/300) does not\nmatter.\nPick one; it changes what the extractor test scores.",
      "originalText": "Not drawn. Today: headline + link, foreign headlines\ntranslated to English at post time.\nIf the message becomes the extractor's sentence, the\nextractor is user-facing: its language, tone and\nerrors reach the group, and translation moves into it.\nIf it stays headline + link, the claim text is internal\nonly and Qwen's re-wording noise (136/300) does not\nmatter.\nPick one; it changes what the extractor test scores.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
