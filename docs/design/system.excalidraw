    {
      "id": "claude2-q1-b",
      "type": "text",
      "x": 1598,
      "y": 1300,
      "width": 336.05,
      "height": 178.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 622435681,
      "version": 2,
      "versionNonce": 1109592387,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789699031756,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "RSS Reader gives you URLs. Classifier and\nExtractor both need the article BODY, and\nthere is no station that gets it.\n\nMeasured this week:\n  • ~127 sites answer 403\n  • 24 of 89 corpus items are headline-only\n  • with a body:    88% right, b2 recall 12/18\n  • without a body: 67% right, b2 recall 0 of 8\n\nThis is the single biggest lever on the board.",
      "originalText": "RSS Reader gives you URLs. Classifier and\nExtractor both need the article BODY, and\nthere is no station that gets it.\n\nMeasured this week:\n  • ~127 sites answer 403\n  • 24 of 89 corpus items are headline-only\n  • with a body:    88% right, b2 recall 12/18\n  • without a body: 67% right, b2 recall 0 of 8\n\nThis is the single biggest lever on the board.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "index": "b0i",
      "autoResize": true
    },
