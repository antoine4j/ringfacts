      "link": null,
      "locked": false,
      "text": "7 · \"NO BODY\" NEEDS A QUALITY CHECK — and a fate",
      "originalText": "7 · \"NO BODY\" NEEDS A QUALITY CHECK — and a fate",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
