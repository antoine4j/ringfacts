    {
      "id": "O63EcRJp-EuAfWlTUq92n",
      "type": "text",
      "x": 3338.6367966542075,
      "y": 1027.6347548434132,
      "width": 538.9567583057441,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 1419493037,
      "version": 556,
      "versionNonce": 1287550573,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790188725860,
      "link": null,
      "locked": false,
      "text": "How to summarize what happened in a week?\n- agent will write a weekly digest, reading last digest,\nweekly claims, and write a new digest summarizing news\nand providing useful links - post weekly\n- audience can click links to see more, and go to the\nstoryboard on the website that will aggregate claims\nper fighter",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How to summarize what happened in a week?\n- agent will write a weekly digest, reading last digest, weekly claims, and write a new digest summarizing news and providing useful links - post weekly\n- audience can click links to see more, and go to the storyboard on the website that will aggregate claims per fighter",
      "autoResize": false,
      "lineHeight": 1.25
    },
