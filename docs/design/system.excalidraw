    {
      "id": "claude-rev-2-b",
      "type": "text",
      "x": 2512,
      "y": 2300,
      "width": 389.76,
      "height": 195.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1263023437,
      "version": 1,
      "versionNonce": 859614143,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790191090513,
      "link": null,
      "locked": false,
      "text": "Gap between consecutive articles in one story:\n   p50 0.1 d · p90 1.0 d · p95 3.3 d · max 9.5 d\nStory span first→last article:\n   p50 0.6 d · p90 6.2 d · max 14.9 d\n4 of 48 stories exceed 7 days — all Topuria, all slow\nforeign pickups of a podcast or interview (015, 037.0,\n036, 022). Soriano predictions: 13 articles in 3 days.\n\nSo 7 days keeps ~92% of stories whole. Caveats: Topuria\nwas thinned, so its gaps read long; the sample is three\nweeks, so spans are capped. Suggest: a window for\nremarks, but fight events match on the BOUT (card 3),\nnot on time — a booking and its result are months apart.",
      "originalText": "Gap between consecutive articles in one story:\n   p50 0.1 d · p90 1.0 d · p95 3.3 d · max 9.5 d\nStory span first→last article:\n   p50 0.6 d · p90 6.2 d · max 14.9 d\n4 of 48 stories exceed 7 days — all Topuria, all slow\nforeign pickups of a podcast or interview (015, 037.0,\n036, 022). Soriano predictions: 13 articles in 3 days.\n\nSo 7 days keeps ~92% of stories whole. Caveats: Topuria\nwas thinned, so its gaps read long; the sample is three\nweeks, so spans are capped. Suggest: a window for\nremarks, but fight events match on the BOUT (card 3),\nnot on time — a booking and its result are months apart.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
