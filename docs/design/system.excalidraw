      "seed": 1057936673,
      "version": 1,
      "versionNonce": 1611773151,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790191090513,
      "link": null,
      "locked": false,
      "text": "Present is not usable: ~10–15 of the 300 bodies are\nCSS, navigation or a video stub (#655 is a stylesheet).\nA length check alone passes them.\nAnd the arrow from Body extractor continues to the\nClassifier regardless. Your caveat leans to \"don't\nintake\". Measured: without a body, bucket-2 recall was\n0 of 8; the other project saw 19% of the raw feed\nheadline-only.\nSuggest: no usable body → mark seen, don't classify,\nCOUNT them. The count is the test of your bet that\nbig news reverberates.",
      "originalText": "Present is not usable: ~10–15 of the 300 bodies are\nCSS, navigation or a video stub (#655 is a stylesheet).\nA length check alone passes them.\nAnd the arrow from Body extractor continues to the\nClassifier regardless. Your caveat leans to \"don't\nintake\". Measured: without a body, bucket-2 recall was\n0 of 8; the other project saw 19% of the raw feed\nheadline-only.\nSuggest: no usable body → mark seen, don't classify,\nCOUNT them. The count is the test of your bet that\nbig news reverberates.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
