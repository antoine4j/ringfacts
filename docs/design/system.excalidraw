    },
    {
      "id": "claude-rev-8-b",
      "type": "text",
      "x": 1512,
      "y": 3060,
      "width": 382.79999999999995,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1449509970,
      "version": 1,
      "versionNonce": 124702340,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790191090513,
      "link": null,
      "locked": false,
      "text": "Store one extract per article. The claim is a group id\nwhose label is the first extract; nothing is merged.\nThe digest writer and the storyboard read all extracts\nof the group, so fidelity is kept (story-125: the third\narticle had the \"why\") and nothing can grow without\nbound. Your board already matches on ARTICLE\nembeddings, so nothing else changes.\nEvery extract stays reproducible: same article, same\nprompt, same sentence give or take wording.",
      "originalText": "Store one extract per article. The claim is a group id\nwhose label is the first extract; nothing is merged.\nThe digest writer and the storyboard read all extracts\nof the group, so fidelity is kept (story-125: the third\narticle had the \"why\") and nothing can grow without\nbound. Your board already matches on ARTICLE\nembeddings, so nothing else changes.\nEvery extract stays reproducible: same article, same\nprompt, same sentence give or take wording.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
