    {
      "id": "claude-rev-4-b",
      "type": "text",
      "x": 1512,
      "y": 2680,
      "width": 382.79999999999995,
      "height": 225.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
