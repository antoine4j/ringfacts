#!/bin/sh
# Runs the offline test tiers before every commit.
#
# This matters more here than in most repos, because the committer is not always
# a person at a keyboard: an agent session can commit here with nothing mounted.
# docs/self-improvement.md §4 tells such a run to verify before claiming, but a
# principle nothing enforces is a principle that erodes. This is the enforcement,
# and it holds whoever is committing.
#
# Only tiers 1 and 2 run — they need no network, no API keys and no database,
# so this stays honest in a check-in session that has no credentials mounted.
# The SQL tier is opt-in (npm run test:sql against a Neon branch).
#
# Installed by setup.sh, or by hand:
#   git config core.hooksPath .githooks
#
# --no-verify skips this. An autonomous run must not: a red suite is a finding
# to report, not an obstacle to route around.

# Other outlets' article text never enters this public repository. The guard
# compares the staged files with the bodies kept on this machine, and passes
# when there are none. History: docs/decisions.md#article-text-out-of-git
if ! node scripts/article-text-guard.js --staged; then
  echo ""
  echo "pre-commit: article text staged — commit aborted."
  exit 1
fi

if ! npm test --silent; then
  echo ""
  echo "pre-commit: tests failed — commit aborted."
  echo "Fix the failure, or if the test itself is now wrong, change the test"
  echo "deliberately and say why in the commit message."
  exit 1
fi

# v0 has its own packages (v0/package.json); its tests run wherever they are installed.
if [ -d v0/node_modules ]; then
  if ! npm test --silent --prefix v0 > /dev/null; then
    echo ""
    echo "pre-commit: v0 tests failed (npm test --prefix v0) — commit aborted."
    exit 1
  fi
else
  echo "pre-commit: v0 packages not installed, v0 tests skipped (npm install --prefix v0)."
fi
